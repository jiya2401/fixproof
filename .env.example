# Nebius Token Factory (OpenAI-compatible). Never commit a real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Verify the exact id for your account with: python scripts/check_nebius.py
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
FIXPROOF_LLM_TIMEOUT_SECONDS=120
FIXPROOF_LLM_MAX_RETRIES=2

# Application
FIXPROOF_ENV=development
FIXPROOF_DATABASE_URL=sqlite:///./fixproof.db
FIXPROOF_MAX_REPAIR_ITERATIONS=3
FIXPROOF_CORS_ORIGINS=http://localhost:5173

# Sandbox modes:
#   "local"  — Process-level sandbox with rlimits and secret scrubbing (used for Render).
#              Requires FIXPROOF_ALLOW_UNSAFE_LOCAL_EXECUTION=true.
#   "docker" — Docker container sandbox (requires Docker CLI and running Docker daemon).
#              Build backend/sandbox-image first.
#   "bwrap"  — bubblewrap user-namespace sandbox (requires Linux host supporting unprivileged user namespaces).
FIXPROOF_SANDBOX_MODE=local
FIXPROOF_SANDBOX_IMAGE=fixproof-sandbox:latest
# Only needed when FIXPROOF_SANDBOX_MODE=local. Enabled inside backend/Dockerfile for Render.
FIXPROOF_ALLOW_UNSAFE_LOCAL_EXECUTION=true

# Test your own project
# Folders the backend may copy projects from (comma-separated). Empty = "Local folder" tab is off.
FIXPROOF_LOCAL_PATH_ROOTS=
FIXPROOF_MAX_PROJECT_MB=50
FIXPROOF_PROJECTS_DIR=./.fixproof_projects

# Open a pull request for a verified patch (optional)
# Fine-grained token with Contents + Pull requests read/write on the target repo
# (classic token: `repo` scope). Leave empty to paste a token in the UI per request instead.
# Never commit a real token.
FIXPROOF_GITHUB_TOKEN=
