# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Application
FIXPROOF_ENV=development
FIXPROOF_DATABASE_URL=sqlite:///./fixproof.db
FIXPROOF_MAX_REPAIR_ITERATIONS=3
FIXPROOF_SANDBOX_MODE=docker
FIXPROOF_CORS_ORIGINS=http://localhost:5173

# Safety: keep false. Local host execution is not part of the intended production design.
FIXPROOF_ALLOW_UNSAFE_LOCAL_EXECUTION=false
